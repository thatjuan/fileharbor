# File Harbor environment configuration.
# Copy to `.env` for local development. Values are env-var-driven only;
# the app never reads a config file at runtime.

# HTTP port the Node process listens on.
PORT=3000

# Directory where File Harbor persists state (SQLite, etc.).
# In Docker this is set to `/data` and the container declares a VOLUME there.
# For local dev outside Docker, point this at a writable local folder.
DATA_DIR=./data

# Optional explicit DB path. If unset, defaults to `${DATA_DIR}/fileharbor.db`.
# Accepts either a raw filesystem path or a `file:` URL.
# DATABASE_URL=file:./data/fileharbor.db

# Node runtime mode. `production` for the built image, `development` locally.
NODE_ENV=development

# --- Auth ---------------------------------------------------------------------

# Secret used by Better Auth to sign session cookies. REQUIRED in production.
# In development, an ephemeral secret is auto-generated per process if unset
# (sessions reset on every restart). Generate one with `openssl rand -hex 32`.
# BETTER_AUTH_SECRET=

# Public-facing base URL Better Auth uses to pin the cookie host and to
# construct callback URLs. Defaults to `http://localhost:${PORT}` if unset,
# which is correct for local dev. Set explicitly in production:
# e.g. `https://fileharbor.example.com`.
# BETTER_AUTH_URL=

# Optional headless admin seed. When BOTH are set AND no user exists at boot,
# the system creates the single admin account from these credentials so a
# fresh container comes up already past first-run setup. After the user
# exists, these values are ignored. Unset (or leave commented) to use the
# browser-based `/setup` wizard instead.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-please
