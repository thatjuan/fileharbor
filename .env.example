# File Harbor environment configuration.
#
# Copy this file to `.env` for local development. Every value is env-var-driven;
# the app never reads a config file at runtime. The full list of variables read
# by the server lives in `apps/server/src/config.ts` — this file mirrors it.
#
# Conventions in the comments below:
#   REQUIRED      — must be set; missing/invalid aborts startup.
#   OPTIONAL      — has a sensible default; uncomment to override.
#   PROD-REQUIRED — required in production; auto-handled in development.

# --- Core runtime ------------------------------------------------------------

# HTTP port the Node process listens on. OPTIONAL. Default: 3000.
PORT=3000

# Node runtime mode. OPTIONAL. Default: `development` outside Docker; the
# production image hard-codes `production`. When `production`, the server also
# serves the built frontend from WEB_DIST_DIR.
NODE_ENV=development

# Directory where File Harbor persists state (SQLite, local-mode object bytes,
# future durable state). OPTIONAL. Default: `./data`. In Docker the image
# sets this to `/data` and declares VOLUME ["/data"]; mount that path to
# persist across container replacements. Outside Docker, point at a writable
# local folder.
DATA_DIR=./data

# Explicit DB path. OPTIONAL. Default: `${DATA_DIR}/fileharbor.db`.
# Accepts either a raw filesystem path or a `file:` URL
# (`file:./data/fileharbor.db`, `file:///data/fileharbor.db`).
# DATABASE_URL=file:./data/fileharbor.db

# Absolute path to the built frontend assets that the server serves when
# NODE_ENV=production. OPTIONAL. Default: `./web` relative to the server's
# working directory. The Docker image sets this to `/app/web`. You should not
# need to set this outside Docker unless you've built the web app to a
# non-default location.
# WEB_DIST_DIR=/app/web

# --- Auth --------------------------------------------------------------------

# Secret used by Better Auth to sign session cookies. PROD-REQUIRED. In
# development an ephemeral secret is auto-generated per process if unset
# (sessions reset on every restart). Generate one with `openssl rand -hex 32`.
# BETTER_AUTH_SECRET=

# Public-facing base URL of this File Harbor instance. OPTIONAL. Default:
# `http://localhost:${PORT}`. Used by Better Auth to pin the cookie host and
# build callback URLs. Set this explicitly in production so it matches the
# external URL users reach the dashboard on, e.g. `https://files.example.com`.
# In S3 mode it is ALSO the origin you grant in your bucket's CORS rules
# (see README → CORS recipes).
# BETTER_AUTH_URL=https://files.example.com

# Optional headless admin seed. OPTIONAL. When BOTH ADMIN_USERNAME and
# ADMIN_PASSWORD are set AND no user exists at boot, the system creates the
# single admin account from these credentials so a fresh container starts
# already past first-run setup. Setting only one of the two aborts startup.
# After the user exists, these values are ignored. Leave unset to use the
# browser-based `/setup` wizard instead.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-please

# --- HTTP security -----------------------------------------------------------

# Enable baseline security response headers. OPTIONAL. Default: true in
# production, false in development/test. Includes CSP, nosniff, referrer
# policy, and frame-ancestor/clickjacking defenses.
# SECURITY_HEADERS_ENABLED=true

# Extra CSP connect-src entries for uncommon S3-compatible hosts that cannot be
# derived from S3_ENDPOINT. Separate multiple sources with spaces or commas.
# SECURITY_CSP_EXTRA_CONNECT_SRC=https://uploads.example.com

# HSTS is enabled by default only when NODE_ENV=production and BETTER_AUTH_URL
# is https://. Set false to disable for unusual proxy deployments. Local HTTP
# development never needs HSTS.
# SECURITY_HSTS_ENABLED=true
# SECURITY_HSTS_MAX_AGE_SECONDS=15552000
# SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
# SECURITY_HSTS_PRELOAD=false

# Trust forwarded headers (X-Forwarded-Host/Proto, CF-Connecting-IP,
# X-Forwarded-For). Default: false. Affects two things:
#   - Rate limiting keys off the real client IP instead of the proxy/loopback
#     address (otherwise every client shares one bucket).
#   - The admin origin guard accepts same-origin mutations (delete/revoke)
#     whose Origin matches the forwarded public host, so deploys whose public
#     URL differs from BETTER_AUTH_URL don't 403.
# Set TRUE in production when reachable exclusively through a trusted reverse
# proxy or Cloudflare Tunnel (the proxy must strip untrusted incoming
# forwarding headers). Leave false if the Node process is directly exposed —
# forwarded headers are client-spoofable without a proxy in front.
# SECURITY_TRUST_PROXY_HEADERS=false

# In-memory rate limits. Defaults are sized for single-container self-hosted
# deployments. Multi-replica deployments need a shared limiter in front.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX_TRACKED_KEYS=20000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_SECONDS=300
# RATE_LIMIT_SETUP_MAX=5
# RATE_LIMIT_SETUP_WINDOW_SECONDS=900
# RATE_LIMIT_PUBLIC_LINK_MAX=8
# RATE_LIMIT_PUBLIC_LINK_WINDOW_SECONDS=300
# RATE_LIMIT_PUBLIC_TICKET_MAX=60
# RATE_LIMIT_PUBLIC_TICKET_WINDOW_SECONDS=60
# RATE_LIMIT_PUBLIC_PART_URL_MAX=120
# RATE_LIMIT_PUBLIC_PART_URL_WINDOW_SECONDS=60
# RATE_LIMIT_PUBLIC_CONFIRM_MAX=120
# RATE_LIMIT_PUBLIC_CONFIRM_WINDOW_SECONDS=60

# --- Storage backend ---------------------------------------------------------
#
# File Harbor stores file bytes via one of two backends. The choice is global,
# selected at boot via STORAGE_BACKEND, and cannot change at runtime.
#
#   local (default) — bytes live on the same data volume as the SQLite DB.
#                     No external dependencies, no CORS required.
#   s3              — bytes live in any S3-compatible bucket you own.
#                     Useful for off-host bytes or multi-host scaling.
#
# OPTIONAL. Default: `local`.
STORAGE_BACKEND=local

# --- Storage: local mode -----------------------------------------------------
#
# Only read when STORAGE_BACKEND=local. Safe to leave commented in S3 mode.

# Directory holding object bytes. OPTIONAL. Default: `${DATA_DIR}/objects`.
# Created on boot if missing; a write-and-unlink probe runs and an
# unwritable directory aborts startup.
# LOCAL_OBJECTS_DIR=/data/objects

# HMAC secret signing local presigned URLs. PROD-REQUIRED when
# STORAGE_BACKEND=local. In development an ephemeral secret is auto-generated
# with a one-time warning (in-flight presigned URLs will not survive a
# restart). Not shared with BETTER_AUTH_SECRET on purpose. Generate one with
# `openssl rand -hex 32`.
# STORAGE_SIGNING_SECRET=

# TTL applied to local presigned URLs, in seconds. OPTIONAL. Default: 300
# (5 minutes). Maximum: 604800 (7 days). Keep short — a leaked URL stops
# being useful quickly.
# STORAGE_PRESIGN_TTL_SECONDS=300

# --- Storage: multipart uploads (both backends) ------------------------------
#
# Files above STORAGE_MULTIPART_THRESHOLD_BYTES are uploaded in parts and
# concatenated server-side. Files at or below the threshold stay on the
# original single-PUT path. See README → Large file uploads for the full
# behaviour (per-part retry, cancel, sweep, link-delete hooks, S3 CORS
# requirements).

# Threshold above which the client uses the multipart protocol. OPTIONAL.
# Default: 104857600 (100 MiB).
# STORAGE_MULTIPART_THRESHOLD_BYTES=104857600

# Server-chosen part size for multipart uploads. OPTIONAL. Default: 16777216
# (16 MiB). Min 5 MiB (S3 rule); max 5 GiB (S3 rule). Auto-bumped at runtime
# for very large objects to stay under S3's 10000-part cap.
# STORAGE_MULTIPART_PART_SIZE_BYTES=16777216

# Maximum seconds an in-flight multipart session may sit pending before the
# background sweep aborts it. OPTIONAL. Default: 7200 (2 hours). Min: 60.
# STORAGE_MULTIPART_TTL_SECONDS=7200

# Hard ceiling per object (single-PUT and multipart both). Init is rejected
# above this. OPTIONAL. Backend-dependent default: local 53687091200 (50 GiB),
# s3 5497558138880 (5 TiB).
# STORAGE_MAX_OBJECT_SIZE_BYTES=53687091200

# --- Storage: S3 mode --------------------------------------------------------
#
# Only required when STORAGE_BACKEND=s3. In `local` mode every variable in this
# block is ignored.
#
# File Harbor never proxies file bytes — every upload/download is a presigned
# URL straight to the bucket. These vars configure that bucket. All of
# S3_ENDPOINT, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_BUCKET are required
# when STORAGE_BACKEND=s3; missing/invalid values abort container startup. A
# `HeadBucket` probe runs at boot and also aborts on failure. The bucket must
# already exist — File Harbor does not create buckets — and must be configured
# for CORS (see the recipes in README.md).

# Endpoint URL of the S3-compatible service. REQUIRED when STORAGE_BACKEND=s3.
#   AWS S3:        https://s3.<region>.amazonaws.com    (e.g. us-east-1)
#   Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
#   MinIO (local): http://localhost:9000
# S3_ENDPOINT=http://localhost:9000

# Region. OPTIONAL. Default: `auto`. Required by the AWS SDK even for non-AWS
# providers; `auto` is fine for R2 and MinIO. Set to your AWS region (e.g.
# `us-east-1`) for AWS S3.
# S3_REGION=auto

# Access key id. REQUIRED when STORAGE_BACKEND=s3.
# S3_ACCESS_KEY_ID=

# Secret access key. REQUIRED when STORAGE_BACKEND=s3.
# S3_SECRET_ACCESS_KEY=

# Bucket name. REQUIRED when STORAGE_BACKEND=s3. Must already exist.
# S3_BUCKET=fileharbor

# Path-style addressing (`endpoint/bucket/key` instead of `bucket.endpoint/key`).
# OPTIONAL. Default: false. Set to `true` for MinIO and for R2 setups that
# require path-style. AWS S3 supports either; virtual-hosted (the default) is
# the modern convention there.
# S3_FORCE_PATH_STYLE=true

# TTL applied to presigned PUT / GET / DELETE URLs, in seconds. OPTIONAL.
# Default: 300 (5 minutes). Maximum: 604800 (7 days, SigV4 ceiling). Short by
# design — a leaked URL stops being useful quickly.
# S3_PRESIGN_TTL_SECONDS=300

# --- Ticket cleanup sweep ----------------------------------------------------
#
# A background job runs inside the same Node process. Every interval it:
#   - Transitions `pending` upload/download tickets older than
#     (presign TTL + TICKET_PENDING_GRACE_SECONDS) to `expired`.
#   - Deletes tickets in terminal states (expired/failed/completed) older than
#     TICKET_RETENTION_SECONDS.
# Race-safe: a ticket that completes during a sweep is preserved.

# How often the sweep runs, in seconds. OPTIONAL. Default: 60.
# TICKET_SWEEP_INTERVAL_SECONDS=60

# Buffer added to the presign TTL before a pending ticket is considered
# expired. OPTIONAL. Default: 60.
# TICKET_PENDING_GRACE_SECONDS=60

# Retention window for terminal tickets, in seconds. OPTIONAL.
# Default: 604800 (7 days).
# TICKET_RETENTION_SECONDS=604800

# --- Cloudflare Tunnel (optional, set both or neither) -----------------------
#
# When BOTH CLOUDFLARE_API_TOKEN and CLOUDFLARE_TUNNEL_DOMAIN are set, the
# container starts cftunn (https://github.com/thatjuan/cftunn) alongside the
# Node server and publishes File Harbor on the custom domain via a Cloudflare
# Tunnel — no inbound port needed on the host. Setting only one of the two
# aborts startup. Required token scopes: Zone:DNS:Edit, Account:Cloudflare
# Tunnel:Edit. The domain's zone must already exist in the Cloudflare account.
#
# When CLOUDFLARE_TUNNEL_DOMAIN is set and BETTER_AUTH_URL is unset,
# BETTER_AUTH_URL is derived as https://<CLOUDFLARE_TUNNEL_DOMAIN>.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_TUNNEL_DOMAIN=files.example.com
