# File Harbor environment configuration.
# Copy to `.env` for local development. Values are env-var-driven only;
# the app never reads a config file at runtime.

# HTTP port the Node process listens on.
PORT=3000

# Directory where File Harbor persists state (SQLite, etc.).
# In Docker this is set to `/data` and the container declares a VOLUME there.
# For local dev outside Docker, point this at a writable local folder.
DATA_DIR=./data

# Optional explicit DB path. If unset, defaults to `${DATA_DIR}/fileharbor.db`.
# Accepts either a raw filesystem path or a `file:` URL.
# DATABASE_URL=file:./data/fileharbor.db

# Node runtime mode. `production` for the built image, `development` locally.
NODE_ENV=development

# --- Auth ---------------------------------------------------------------------

# Secret used by Better Auth to sign session cookies. REQUIRED in production.
# In development, an ephemeral secret is auto-generated per process if unset
# (sessions reset on every restart). Generate one with `openssl rand -hex 32`.
# BETTER_AUTH_SECRET=

# Public-facing base URL Better Auth uses to pin the cookie host and to
# construct callback URLs. Defaults to `http://localhost:${PORT}` if unset,
# which is correct for local dev. Set explicitly in production:
# e.g. `https://fileharbor.example.com`.
# BETTER_AUTH_URL=

# Optional headless admin seed. When BOTH are set AND no user exists at boot,
# the system creates the single admin account from these credentials so a
# fresh container comes up already past first-run setup. After the user
# exists, these values are ignored. Unset (or leave commented) to use the
# browser-based `/setup` wizard instead.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-please

# --- Storage (S3-compatible) -------------------------------------------------
#
# File Harbor never proxies file bytes — every upload/download is a presigned
# URL straight to the bucket. These vars configure that bucket. All of
# S3_ENDPOINT, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_BUCKET are REQUIRED;
# missing/invalid values abort container startup. A `HeadBucket` probe runs
# at boot and also aborts startup on failure.

# Endpoint URL of the S3-compatible service. REQUIRED.
#   AWS S3:        https://s3.us-east-1.amazonaws.com
#   Cloudflare R2: https://<account>.r2.cloudflarestorage.com
#   MinIO (local): http://localhost:9000
S3_ENDPOINT=http://localhost:9000

# Region. Required by the SDK even for non-AWS providers; `auto` is fine for
# R2/MinIO. Defaults to `auto` if unset.
S3_REGION=auto

# Credentials. REQUIRED.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Bucket. REQUIRED. Must already exist — File Harbor does not create buckets.
S3_BUCKET=fileharbor

# Path-style addressing (`endpoint/bucket/key` vs `bucket.endpoint/key`).
# Set to `true` for MinIO and for R2 setups that require path-style.
# Default: false.
S3_FORCE_PATH_STYLE=true

# TTL applied to presigned PUT / GET / DELETE URLs, in seconds. Short by
# design — a leaked URL stops being useful quickly. Maximum is 604800
# (7 days, SigV4 ceiling). Default: 300 (5 minutes).
# S3_PRESIGN_TTL_SECONDS=300

# --- Ticket cleanup sweep (issue #10) ----------------------------------------
#
# A background job runs inside the same Node process. Every interval, it:
#   - Transitions `pending` upload/download tickets older than
#     (S3_PRESIGN_TTL_SECONDS + TICKET_PENDING_GRACE_SECONDS) to `expired`.
#   - Deletes tickets in terminal states (expired/failed/completed) older
#     than TICKET_RETENTION_SECONDS.
# Race-safe: a ticket that completes during a sweep is preserved.

# How often the sweep runs, in seconds. Default: 60.
# TICKET_SWEEP_INTERVAL_SECONDS=60

# Buffer added to the presign TTL before a pending ticket is considered
# expired. Default: 60.
# TICKET_PENDING_GRACE_SECONDS=60

# Retention window for terminal tickets, in seconds. Default: 604800 (7 days).
# TICKET_RETENTION_SECONDS=604800
